  "text": "那么就需要输入这个名字"
 },
 {
  "start": 586.14,
  "end": 588.14,
  "text": "我们直接在这把这个文件夹的路径复制一下"
 },
 {
  "start": 588.14,
  "end": 589.14,
  "text": "点击右键"
 },
 {
  "start": 589.14,
  "end": 590.14,
