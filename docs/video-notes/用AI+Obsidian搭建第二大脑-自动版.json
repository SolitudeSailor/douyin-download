  "text": "可能是一些文档"
 },
 {
  "start": 646.42,
  "end": 647.42,
  "text": "也可能是一堆数据"
 },
 {
  "start": 647.42,
  "end": 648.42,
  "text": "那么这个更简单了"
 },
 {
  "start": 648.42,
  "end": 649.42,
  "text": "我们直接扔给WorkBuddy"
 },
 {
  "start": 649.42,
  "end": 650.42,
  "text": "我们打开WorkBuddy"
 },
 {
  "start": 650.42,
  "end": 652.42,
  "text": "然后把你想要存入的文件"
 },
 {
  "start": 652.42,
  "end": 653.42,
  "text": "直接扔给他"
 },
 {
  "start": 653.42,
  "end": 656.42,
  "text": "比如说这是一个Word的格式的一个文档"
 },
 {
  "start": 656.42,
  "end": 657.42,
  "text": "我们扔给他"
 },
 {
  "start": 657.42,
  "end": 658.42,
  "text": "然后告诉他"
 },
 {
