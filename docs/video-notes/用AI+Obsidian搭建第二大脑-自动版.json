[
 {
  "start": 0.0,
  "end": 3.2,
  "text": "如何用 AI 加 Obsidian 搭建在 AI 时代的第二大脑"
 },
 {
  "start": 3.2,
  "end": 5.64,
  "text": "这条视频纯实操 一步一步带你搭建好"
 },
 {
  "start": 5.64,
  "end": 9.4,
  "text": "让你把所有收藏过的文章视频报告都变成 AS 考的养料"
 },
 {
  "start": 9.4,
  "end": 12.48,
  "text": "并且 AI 还可以通过这套系统主动复盘不断叠在"
 },
 {
  "start": 12.48,
  "end": 14.56,
  "text": "最终实现自我生长、自我计划"
 },
 {
  "start": 14.56,
  "end": 17.28,
  "text": "无论你是想学习、研究或者管理任何领域"
 },
 {
  "start": 17.28,
  "end": 19.28,
  "text": "有这一套系统就够了 OK 咱们开始"
 },
 {
  "start": 19.28,
  "end": 20.6,
  "text": "第一就是先理论后事操啊"
 },
 {
  "start": 20.6,
  "end": 22.12,
  "text": "咱们这套系统其实非常简单"
 },
 {
  "start": 22.12,
  "end": 23.08,
  "text": "一共就分三个部分"
 },
 {
  "start": 23.08,
  "end": 25.92,
  "text": "第一个 图书馆 负责存放你所有的知识和资料"
 },
 {
  "start": 25.92,
  "end": 27.96,
  "text": "第二个 管理规则 负责规定这些资料"
 },
 {
  "start": 27.96,
  "end": 29.84,
  "text": "该怎么提链、该怎么整理、该怎么分类"
 },
 {
  "start": 29.84,
  "end": 31.32,
  "text": "第三个 就是图书馆的管理员"
 },
 {
  "start": 31.32,
  "end": 32.36,
  "text": "负责按规定干活"
 },
 {
  "start": 32.36,
  "end": 35.28,
  "text": "帮你整理、解答以及维护整个知识系统运作"
 },
 {
  "start": 35.28,
  "end": 37.16,
  "text": "那整个系统的运转逻辑就很简单了"
 },
 {
  "start": 37.16,
  "end": 39.04,
  "text": "当你看到任何有价值的内容"
 },
 {
  "start": 39.04,
  "end": 41.04,
  "text": "比如说文章视频 你就扔给管理员"
 },
 {
  "start": 41.04,
  "end": 43.0,
  "text": "管理员会根据规则处理你的内容"
 },
 {
  "start": 43.0,
  "end": 44.16,
  "text": "把它存到知识库中"
 },
 {
  "start": 44.16,
  "end": 46.16,
  "text": "并且跟你已有的知识进行关联"
 },
 {
  "start": 46.16,
  "end": 47.4,
  "text": "形成一个知识网络"
 },
 {
  "start": 47.4,
  "end": 48.52,
  "text": "后续你的任何问题"
 },
 {
  "start": 48.52,
  "end": 50.92,
  "text": "管理员都会根据这个知识网络去帮你解决"
 },
 {
  "start": 50.92,
  "end": 52.08,
  "text": "并且优质的答案"
 },
 {
  "start": 52.08,
  "end": 53.72,
  "text": "会继续存进你的知识库中"
 },
 {
  "start": 53.72,
  "end": 55.28,
  "text": "成为知识体系的一部分"
 },
 {
  "start": 55.28,
  "end": 57.48,
  "text": "而且管理员还会定期给知识库做体检"
 },
 {
  "start": 57.48,
  "end": 58.92,
  "text": "不断迭代你的知识体系"
 },
 {
  "start": 58.92,
  "end": 59.8,
  "text": "那循环网库呢"
 },
 {
  "start": 59.8,
  "end": 61.32,
  "text": "你的第二大脑就会越来越强大"
 },
 {
  "start": 61.32,
  "end": 63.32,
  "text": "帮助你在任何领域都成为专家"
 },
 {
  "start": 63.32,
  "end": 65.44,
  "text": "OK 我相信你已经明白这道系统的威力了"
 },
 {
  "start": 65.44,
  "end": 67.52,
  "text": "那接下来咱们就进入实操环节"
 },
 {
  "start": 68.12,
  "end": 69.84,
  "text": "整个过程需要用到的工具就两个"
 },
 {
  "start": 69.84,
  "end": 70.72,
  "text": "一个是Obsidian"
 },
 {
  "start": 70.72,
  "end": 71.6,
  "text": "一个就是Agent"
 },
 {
  "start": 71.6,
  "end": 72.64,
  "text": "无论是豆包工作"
 },
 {
  "start": 72.64,
  "end": 73.72,
  "text": "WorkBuddy或者codex"
 },
 {
  "start": 73.72,
  "end": 75.08,
  "text": "任意Agent都是可以的"
 },
 {
  "start": 75.08,
  "end": 76.6,
  "text": "今天咱们拿WorkBuddy来演示"
 },
 {
  "start": 76.6,
  "end": 77.28,
  "text": "咱们开始"
 },
 {
  "start": 77.28,
  "end": 77.72,
  "text": "第一步"
 },
 {
  "start": 77.72,
  "end": 80.04,
  "text": "咱们先搭建几这个存放知识的图书馆"
 },
 {
  "start": 80.04,
  "end": 81.04,
  "text": "先打开Obsidian"
 },
 {
  "start": 81.04,
  "end": 82.24,
  "text": "咱们新建一个仓库"
 },
 {
  "start": 82.24,
  "end": 83.56,
  "text": "那如果你不会操作Obsidian"
 },
 {
  "start": 83.56,
  "end": 85.0,
  "text": "可以去看我上一期的视频"
 },
 {
  "start": 85.0,
  "end": 86.44,
  "text": "我们在这点击新建"
 },
 {
  "start": 86.44,
  "end": 88.2,
  "text": "然后输入一个仓库的名字"
 },
 {
  "start": 88.2,
  "end": 90.28,
  "text": "就叫大梁的第二大脑"
 },
 {
  "start": 90.28,
  "end": 91.96,
  "text": "然后我们选择一个"
 },
 {
  "start": 91.96,
  "end": 93.16,
  "text": "电脑存放的位置"
 },
 {
  "start": 93.8,
  "end": 94.44,
  "text": "这个位置随意"
 },
 {
  "start": 94.44,
  "end": 95.64,
  "text": "你想存到哪里都可以"
 },
 {
  "start": 95.68,
  "end": 96.84,
  "text": "然后我们点击创建"
 },
 {
  "start": 97.98,
  "end": 98.3,
  "text": "OK"
 },
 {
  "start": 98.3,
  "end": 99.1,
  "text": "建好之后"
 },
 {
  "start": 99.1,
  "end": 100.54,
  "text": "我们就已经进入到了"
 },
 {
  "start": 100.54,
  "end": 101.86,
  "text": "Obsidian这个图书馆了"
 },
 {
  "start": 101.86,
  "end": 104.1,
  "text": "接下来咱们就要把图书馆装修一下"
 },
 {
  "start": 104.1,
  "end": 106.34,
  "text": "也就是把整个的文件系统搭建起来"
 },
 {
  "start": 106.34,
  "end": 108.46,
  "text": "这一步我们可以把我们写好的方法论"
 },
 {
  "start": 108.46,
  "end": 109.98,
  "text": "直接交给AI去搭建"
 },
 {
  "start": 109.98,
  "end": 110.74,
  "text": "我先说一下"
 },
 {
  "start": 110.74,
  "end": 112.98,
  "text": "这个搭建思路是源于AI领域的大神"
 },
 {
  "start": 112.98,
  "end": 115.38,
  "text": "OpenAI的创始成员卡帕西的一篇文章"
 },
 {
  "start": 115.38,
  "end": 117.62,
  "text": "你可以到GitHub上去找到它的原文"
 },
 {
  "start": 117.62,
  "end": 118.58,
  "text": "比如说我们可以看"
 },
 {
  "start": 118.58,
  "end": 120.18,
  "text": "这里是GitHub上它的原文"
 },
 {
  "start": 120.18,
  "end": 122.1,
  "text": "你可以把这段原文直接复制下来"
 },
 {
  "start": 122.1,
  "end": 122.7,
  "text": "交给AI"
 },
 {
  "start": 122.7,
  "end": 123.7,
  "text": "如果你没有条件"
 },
 {
  "start": 123.82,
  "end": 125.62,
  "text": "你也可以直接用我优化过的版本"
 },
 {
  "start": 125.62,
  "end": 127.98,
  "text": "我在这写了一个优化后的中文版"
 },
 {
  "start": 127.98,
  "end": 129.06,
  "text": "我们可以来看一下"
 },
 {
  "start": 129.93,
  "end": 131.21,
  "text": "这是整个大家思路"
 },
 {
  "start": 131.21,
  "end": 132.13,
  "text": "我们都会写好"
 },
 {
  "start": 132.13,
  "end": 133.09,
  "text": "写好之后"
 },
 {
  "start": 133.09,
  "end": 134.53,
  "text": "接下来就非常简单了"
 },
 {
  "start": 134.53,
  "end": 135.73,
  "text": "我们打开WorkBuddy"
 },
 {
  "start": 135.73,
  "end": 139.25,
  "text": "然后把这个方法论直接扔给WorkBuddy"
 },
 {
  "start": 139.25,
  "end": 139.93,
  "text": "这里注意"
 },
 {
  "start": 139.93,
  "end": 141.33,
  "text": "我们要选择工作空间"
 },
 {
  "start": 141.33,
  "end": 142.73,
  "text": "打开本地文件夹"
 },
 {
  "start": 143.92,
  "end": 147.16,
  "text": "选择到Obsidian的这个知识仓库所在的文件夹"
 },
 {
  "start": 147.16,
  "end": 148.52,
  "text": "就是这个大梁第二大脑"
 },
 {
  "start": 148.52,
  "end": 149.4,
  "text": "咱们刚刚创建的"
 },
 {
  "start": 149.4,
  "end": 150.28,
  "text": "我们选择它"
 },
 {
  "start": 150.28,
  "end": 151.28,
  "text": "然后点击打开"
 },
 {
  "start": 151.28,
  "end": 152.88,
  "text": "因为WorkBuddy的工作空间"
 },
 {
  "start": 152.88,
  "end": 154.12,
  "text": "和Obsidian的知识仓库"
 },
 {
  "start": 154.36,
  "end": 156.56,
  "text": "本质上都是你电脑里的一个文件夹"
 },
 {
  "start": 156.56,
  "end": 158.36,
  "text": "所以你选择了这个文件夹之后"
 },
 {
  "start": 158.36,
  "end": 161.32,
  "text": "WorkBuddy就可以操作Obsidian仓库里的所有文件了"
 },
 {
  "start": 161.32,
  "end": 162.48,
  "text": "然后我们只需要告诉它"
 },
 {
  "start": 162.48,
  "end": 164.24,
  "text": "按照这个方法论"
 },
 {
  "start": 164.24,
  "end": 165.96,
  "text": "帮我搭建知识仓库"
 },
 {
  "start": 171.79,
  "end": 177.79,
  "text": "最后,我们再给它一个完全访问的权限,让它一次性的把握干好,然后点击发送。"
 },
 {
  "start": 177.79,
  "end": 183.79,
  "text": "运行的过程中,我说一个题外话,如果你跟着我上节课的节奏,在 Obsidian 里装好了Cloudian 的插件,"
 },
 {
  "start": 183.79,
  "end": 186.79,
  "text": "那你就可以在 Obsidian 里面用内置的 AI,它更方便。"
 },
 {
  "start": 186.79,
  "end": 188.79,
  "text": "OK,咱们继续回到 WorkBuddy。"
 },
 {
  "start": 188.79,
  "end": 191.79,
  "text": "好的,我们可以看到在这儿呢, WorkBuddy 它提示已经搭建完了。"
 },
 {
  "start": 191.79,
  "end": 194.79,
  "text": "那么接下来我们回到 Obsidian 这个仓库里面,"
 },
 {
  "start": 194.79,
  "end": 201.79,
  "text": "我们可以看到 Obsidian 的左侧整个的文件列表里面已经搭建好了咱们这个知识仓库所需要的所有文件。"
 },
 {
  "start": 201.79,
  "end": 203.79,
  "text": "我们来一次看一下这个架构。"
 },
 {
  "start": 203.79,
  "end": 205.79,
  "text": "第一个是原始资料,就是肉这个文件夹。"
 },
 {
  "start": 205.79,
  "end": 208.79,
  "text": "你所有想存到你知识系统里的内容都可以放到这里面。"
 },
 {
  "start": 208.79,
  "end": 214.79,
  "text": "第二个是 Agents.md 这一个文件,你看这里面写好了就是咱们图书馆的管理规则,"
 },
 {
  "start": 214.79,
  "end": 217.79,
  "text": "里面会清楚地记录这个知识库的运转规则。"
 },
 {
  "start": 217.79,
  "end": 221.79,
  "text": "AI 拿到你的原始资料以后,应该怎么样去思考和处理都会写在这里面。"
 },
 {
  "start": 221.79,
  "end": 224.79,
  "text": "这个规则是给 AI 看的,也就是咱们的图书馆管理员。"
 },
 {
  "start": 224.79,
  "end": 227.79,
  "text": "而第三个文件夹叫做知识库 Wiki。"
 },
 {
  "start": 227.79,
  "end": 230.79,
  "text": "这里面是被 AI 处理以后的知识和信息存放的地方,"
 },
 {
  "start": 230.79,
  "end": 233.79,
  "text": "我们点开看一下,你可以看到里面有不同的分类,"
 },
 {
  "start": 233.79,
  "end": 237.79,
  "text": "包括什么呢?分析、概念、实体、资料摘要等等。"
 },
 {
  "start": 237.79,
  "end": 240.79,
  "text": "同时这还有整个知识库里面的知识目录,"
 },
 {
  "start": 240.79,
  "end": 244.79,
  "text": "也就是说你存进来的所有知识,AI 会自动帮你做好目录和分类,"
 },
 {
  "start": 244.79,
  "end": 248.79,
  "text": "以及知识库每次迭代的日治,你增加了什么知识,"
 },
 {
  "start": 249.79,
  "end": 251.79,
  "text": "以及整个知识库的一个总揽。"
 },
 {
  "start": 251.79,
  "end": 253.79,
  "text": "那么当然还有一些它自己的操作记录,"
 },
 {
  "start": 253.79,
  "end": 255.79,
  "text": "它会放在上面这个报告里面。"
 },
 {
  "start": 255.79,
  "end": 257.79,
  "text": "那么这几样东西以及里面所有的文件,"
 },
 {
  "start": 257.79,
  "end": 259.79,
  "text": "就组成了咱们一开始说的知识系统。"
 },
 {
  "start": 259.79,
  "end": 261.79,
  "text": "你想让知识系统吸收的东西,"
 },
 {
  "start": 261.79,
  "end": 263.79,
  "text": "你就放在这个原始资料文件夹里,"
 },
 {
  "start": 263.79,
  "end": 264.79,
  "text": "然后让 AI 进行设入,"
 },
 {
  "start": 264.79,
  "end": 268.79,
  "text": "AI 就会根据 agent 这个文档里面的规则进行,"
 },
 {
  "start": 268.79,
  "end": 271.79,
  "text": "读取原始资料并分析,然后分类储存,"
 },
 {
  "start": 271.79,
  "end": 274.79,
  "text": "整理摘要,更新目录,储存日治等一系列操作。"
 },
 {
  "start": 274.79,
  "end": 276.79,
  "text": "也就是说它会把你存的一份资料,"
 },
 {
  "start": 276.79,
  "end": 278.79,
  "text": "把它掰开揉碎的拆明白、搞明白,"
 },
 {
  "start": 278.79,
  "end": 280.79,
  "text": "然后对应的存放到你的知识库里,"
 },
 {
  "start": 280.79,
  "end": 283.79,
  "text": "并且它会把所有相关的概念进行链接,"
 },
 {
  "start": 283.79,
  "end": 284.79,
  "text": "最终形成知识网络。"
 },
 {
  "start": 284.79,
  "end": 286.79,
  "text": "那么以后你每次要调用知识呢,"
 },
 {
  "start": 286.79,
  "end": 290.79,
  "text": "AI 就会顺着这个目录去查看知识库里面所有相关的内容,"
 },
 {
  "start": 290.79,
  "end": 292.79,
  "text": "思考并回答你的问题。"
 },
 {
  "start": 292.79,
  "end": 293.79,
  "text": "你们探讨出来的优质答案,"
 },
 {
  "start": 293.79,
  "end": 296.79,
  "text": "AI 还会继续按照规则存进你的知识库里面,"
 },
 {
  "start": 296.79,
  "end": 300.79,
  "text": "并且AI 最后还会定期给你的知识库整个做一个体检,"
 },
 {
  "start": 300.79,
  "end": 302.79,
  "text": "检查知识库里面有没有观点冲突,"
 },
 {
  "start": 302.79,
  "end": 305.79,
  "text": "有没有事实不符,有没有信息互相矛盾的地方,"
 },
 {
  "start": 305.79,
  "end": 308.79,
  "text": "整个过程就像人类大脑学习知识是一样的,"
 },
 {
  "start": 308.79,
  "end": 311.79,
  "text": "先阅读,再总结,再分类,最后再形成知识关联。"
 },
 {
  "start": 311.79,
  "end": 312.79,
  "text": "随日你不断地使用,"
 },
 {
  "start": 312.79,
  "end": 314.79,
  "text": "这个第二大脑的神经源突出也会越来越多,"
 },
 {
  "start": 314.79,
  "end": 316.79,
  "text": "对知识的理解就会越来越扎实,"
 },
 {
  "start": 316.79,
  "end": 319.79,
  "text": "这个就是它争执为第二大脑的核心原因。"
 },
 {
  "start": 319.79,
  "end": 322.79,
  "text": "接下来咱们就来实际的跑一遍整个的流程。"
 },
 {
  "start": 322.79,
  "end": 324.83,
  "text": "那首先呢就是后期素材,"
 },
 {
  "start": 324.83,
  "end": 327.83,
  "text": "我们平时要把网上看到的一些优质文章视频"
 },
 {
  "start": 327.83,
  "end": 329.83,
  "text": "都放在原始资料的文件夹里,"
 },
 {
  "start": 329.83,
  "end": 331.83,
  "text": "你一篇一篇的保存导入就太慢了。"
 },
 {
  "start": 331.83,
  "end": 334.83,
  "text": "这里我要给你推荐一个Obsidian非常好用的工具,"
 },
 {
  "start": 334.83,
  "end": 336.83,
  "text": "叫做Obsidian Web Clipper,"
 },
 {
  "start": 336.83,
  "end": 337.83,
  "text": "它是一个chrome插件,"
 },
 {
  "start": 337.83,
  "end": 341.83,
  "text": "几乎可以一键把你看到的所有内容都存到Obsidian里面。"
 },
 {
  "start": 341.83,
  "end": 342.83,
  "text": "那它怎么安装呢?"
 },
 {
  "start": 342.83,
  "end": 344.83,
  "text": "我们首先打开Obsidian的官网,"
 },
 {
  "start": 353.54,
  "end": 359.54,
  "text": "它会再次跳转到另一个页面,然后我们再次点击添加到 Chrome 这个按钮,这个插件就安装好了。"
 },
 {
  "start": 359.54,
  "end": 364.54,
  "text": "当然由于我已经安装过了,所以这里面只会显示移除。如果你没有安装过的话,这里是一个添加的按钮。"
 },
 {
  "start": 364.54,
  "end": 370.54,
  "text": "安装好了之后,插件就长这个样子,我们把它置领一下,把它放到你乱记的顶部,后面就方便使用了。"
 },
 {
  "start": 371.54,
  "end": 376.54,
  "text": "那么具体它怎么使用呢?我们举个例子,比如说咱们平时看到一篇文章,你觉得它不错,你想收藏起来。"
 },
 {
  "start": 376.54,
  "end": 381.54,
  "text": "过去的方法你可能要全选,然后复制,然后在本地保存,再拖入到 Obsidian 里面。"
 },
 {
  "start": 381.54,
  "end": 387.54,
  "text": "然后现在我们可以直接在这个网页什么都不用做,然后点击 Obsidian 这个插件。"
 },
 {
  "start": 387.54,
  "end": 393.54,
  "text": "你看我点击一下左键,它就会立刻识别这个网页里面的所有信息,然后把它抓取出来。"
 },
 {
  "start": 393.54,
  "end": 401.54,
  "text": "包含这个网站的标题,它的链接,你收藏的日期,它的一些标签等等,还有整个内容的证文,以及内容里面的图片链接。"
 },
 {
  "start": 401.54,
  "end": 405.54,
  "text": "然后我们分评来看,我们右边是浏览器,左边是我们的 Obsidian。"
 },
 {
  "start": 405.54,
  "end": 414.54,
  "text": "注意看,这个时候 Obsidian 里面还没有现在这篇文章,然后我们点一下这个插件,它识别到你所有的信息之后,点一下这个添加到 Obsidian,我们点一下左键。"
 },
 {
  "start": 414.6,
  "end": 419.6,
  "text": "你看 Obsidian 这边会立刻创建一个新的文件夹叫 Clippings,然后我们点开这个文件夹,"
 },
 {
  "start": 419.6,
  "end": 427.6,
  "text": "你就可以看到你刚刚收藏的这个文章就已经在这里面了。中间就是刚刚这篇文章,你看从标题到标签到日期到内容到图片,"
 },
 {
  "start": 427.6,
  "end": 435.6,
  "text": "全都完整的出现在你Obsidian 里面,而且这是存到你电脑里的一个本地文件,这样我们在收藏任何信息它就非常方便了。"
 },
 {
  "start": 435.6,
  "end": 441.6,
  "text": "那当然,有的时候我们想收藏的可能不仅仅是文章,比如说你看到一个非常优质的视频,你也想把它存进来,那怎么做呢?"
 },
 {
  "start": 441.6,
  "end": 448.6,
  "text": "我们仍然可以用这个插件,比如说我们还是打开我们的浏览器,假设你看到这样的一条视频,你觉得非常好,你想把它收藏起来,那怎么做呢?"
 },
 {
  "start": 448.6,
  "end": 454.6,
  "text": "我们仍然点击这个插件,我们单击一下,你会发现它就把这条视频的信息全都提取出来了。"
 },
 {
  "start": 454.6,
  "end": 457.6,
  "text": "提取出来之后,我秘然点添加到Obsidian。"
 },
 {
  "start": 462.14,
  "end": 465.14,
  "text": "那不仅这个视频进来了 它底下所有的内容"
 },
 {
  "start": 465.14,
  "end": 469.14,
  "text": "这个视频带上时间戳的字幕全都已经导入进来了"
 },
 {
  "start": 469.14,
  "end": 471.14,
  "text": "也就是说它是一个什么东西呢"
 },
 {
  "start": 471.14,
  "end": 474.14,
  "text": "它是一个可以实时查看的视频"
 },
 {
  "start": 474.14,
  "end": 476.14,
  "text": "以及这个视频的所有的文字内容"
 },
 {
  "start": 476.14,
  "end": 478.14,
  "text": "并且它虽然存到你的电脑硬盘里了"
 },
 {
  "start": 478.14,
  "end": 481.14,
  "text": "但是这个视频它是一个在线播放的链接"
 },
 {
  "start": 481.14,
  "end": 483.14,
  "text": "也就是说这个视频它并不会占用你的空间"
 },
 {
  "start": 483.14,
  "end": 486.14,
  "text": "你只要电脑有网络 打开这个文档就可以播放"
 },
 {
  "start": 486.14,
  "end": 489.14,
  "text": "如果你没有网络的话 你也可以看下面的逐字稿"
 },
 {
  "start": 489.14,
  "end": 491.14,
  "text": "OK 这个就是这个插件好用的地方"
 },
 {
  "start": 491.14,
  "end": 493.14,
  "text": "但是这个时候出现了一个问题"
 },
 {
  "start": 493.14,
  "end": 497.14,
  "text": "就是你存的文章 它默认是在Clippins这个文件夹里面"
 },
 {
  "start": 497.14,
  "end": 500.14,
  "text": "但是我们是希望把资料存到原始资料肉这个文件夹里"
 },
 {
  "start": 500.14,
  "end": 502.14,
  "text": "那我们除了把这几个文章拖进去之外"
 },
 {
  "start": 502.14,
  "end": 504.14,
  "text": "我们还有没有更快的方法呢 是有的"
 },
 {
  "start": 504.14,
  "end": 507.14,
  "text": "我们还是回到浏览器 然后点击这个插件"
 },
 {
  "start": 507.14,
  "end": 510.14,
  "text": "你可以看到这个插件右上角有一个齿轮的小图标"
 },
 {
  "start": 510.14,
  "end": 512.14,
  "text": "这个是设置 我们点击一下设置"
 },
 {
  "start": 512.14,
  "end": 514.14,
  "text": "进到这个插件的设置面板里"
 },
 {
  "start": 514.14,
  "end": 516.14,
  "text": "我们可以把它保存的默认路径"
 },
 {
  "start": 516.14,
  "end": 518.14,
  "text": "改到这个原始资料肉这个文件夹里"
 },
 {
  "start": 518.14,
  "end": 520.14,
  "text": "那怎么改呢 我来一步一步带你操作"
 },
 {
  "start": 520.14,
  "end": 521.14,
  "text": "首先是常规设置这个页面"
 },
 {
  "start": 521.14,
  "end": 523.14,
  "text": "这个页面这里有一个保管库"
 },
 {
  "start": 523.14,
  "end": 526.14,
  "text": "我们要在这个保管库输入你Obsidian知识仓库的名字"
 },
 {
  "start": 526.14,
  "end": 528.14,
  "text": "比如说我们可以看左下角"
 },
 {
  "start": 528.14,
  "end": 529.14,
  "text": "咱们的这个知识仓库叫什么呢"
 },
 {
  "start": 529.14,
  "end": 530.14,
  "text": "叫大梁的第二大脑"
 },
 {
  "start": 530.14,
  "end": 533.14,
  "text": "所以我们就要在这输入大梁的第二大脑"
 },
 {
  "start": 533.14,
  "end": 534.14,
  "text": "这个仓库的名字"
 },
 {
  "start": 534.14,
  "end": 535.14,
  "text": "这就告诉他"
 },
 {
  "start": 535.14,
  "end": 537.14,
  "text": "你要把你收藏的内容保存到这个仓库里"
 },
 {
  "start": 537.14,
  "end": 540.14,
  "text": "然后在这我们输入完名字之后一定要按回车"
 },
 {
  "start": 540.14,
  "end": 543.14,
  "text": "然后他呈现出这个样子才算这个仓库入入有效"
 },
 {
  "start": 543.14,
  "end": 544.14,
  "text": "这是第一步"
 },
 {
  "start": 544.14,
  "end": 545.14,
  "text": "输入完这个之后"
 },
 {
  "start": 545.14,
  "end": 547.14,
  "text": "第二步我们看一下下面"
 },
 {
  "start": 547.14,
  "end": 548.14,
  "text": "下面的有一个模板"
 },
 {
  "start": 548.14,
  "end": 550.14,
  "text": "这有一个default就是默认的意思"
 },
 {
  "start": 550.14,
