<div id="toast"></div>

<script>
let pollTimer = null;
// 最近一次拉到的任务列表（beforeunload 里要用它判断「有没有任务在跑」）
let lastTasks = [];

function toast(msg, kind){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.className = 'show ' + (kind || '');
  clearTimeout(t._h);
  t._h = setTimeout(()=>{ t.className=''; }, 4200);
}

async function api(path, opts){
  const r = await fetch(path, Object.assign({
    headers: {'Content-Type':'application/json'}
  }, opts || {}));
  let data = {};
  try { data = await r.json(); } catch(e){}
  return { ok: r.ok, status: r.status, data };
}

/* ---------- 主题 ---------- */
const ICON_MOON = '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.6A8.6 8.6 0 1 1 9.4 4a6.9 6.9 0 0 0 10.6 10.6z"/></svg>';
const ICON_SUN  = '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="12" cy="12" r="4.1"/><path d="M12 2.6v2.3M12 19.1v2.3M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.6 12h2.3M19.1 12h2.3M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6"/></svg>';

function syncThemeBtn(){
  const dark = document.documentElement.getAttribute('data-theme') === 'dark';
  const b = document.getElementById('themeBtn');
  if (!b) return;
  b.innerHTML = dark ? ICON_SUN : ICON_MOON;
  b.title = dark ? '切换到浅色主题' : '切换到深色主题';
}
function toggleTheme(){
  const root = document.documentElement;
  const dark = root.getAttribute('data-theme') === 'dark';
  const next = dark ? 'light' : 'dark';
  // 换主题这一帧把所有过渡关掉：不然大面积背景在 0.2s 里慢慢化、
  // 小块元素却已经跳完，看着就是拖尾。同步读一次布局把新样式压实，
  // 下一帧再撤掉开关 —— 这样 hover / focus 的过渡平时完全不受影响。
  root.classList.add('no-anim');
  root.setAttribute('data-theme', next);
  void root.offsetHeight;
  requestAnimationFrame(() => requestAnimationFrame(
    () => root.classList.remove('no-anim')));
  try { localStorage.setItem('dyd-theme', next); } catch(e){}
  syncThemeBtn();
}

/* ---------- 配置 ---------- */
async function loadConfig(){
  const { data } = await api('/api/config');
  setCookieBadge(!!data.cookie_set);
  if (data.default_max_counts != null){
    document.getElementById('maxCounts').value = data.default_max_counts;
  }
  if (data.cookie_set){
    setLoginStatus(lastSeen + (lastSeen ? '　' : '') + '✅ 已登录，可直接开始下载', '');
  } else {
    setLoginStatus('尚未登录，请点「打开登录窗口」', '');
  }
  if (data.browser){
    document.getElementById('loginBtn').textContent = '打开登录窗口（' + data.browser + '）';
  }
}

function setCookieBadge(isSet){
  const b = document.getElementById('cookieBadge');
  if (isSet){ b.textContent = '已登录'; b.className = 'badge ok'; }
  else { b.textContent = '未登录'; b.className = 'badge bad'; }
}

/* ---------- 登录 ---------- */
let loginTimer = null;
let lastSeen = '';

function setLoginStatus(text, kind){
  const el = document.getElementById('loginStatus');
  el.textContent = text || '';
  el.className = 'msg' + (kind ? ' ' + kind : '');
}

function setLoginBusy(busy, showBar){
  document.getElementById('loginBtn').disabled = busy;
  document.getElementById('syncBtn').disabled = busy;
  document.getElementById('loginBar').style.display = (busy && showBar) ? '' : 'none';
}

async function startLogin(interactive){
  const { ok, status, data } = await api('/api/login/start', {
    method:'POST', body: JSON.stringify({interactive: !!interactive})
  });
  if (!ok && status !== 202){
    toast(data.message || '启动失败', 'err');
    setLoginStatus(data.message || '启动失败', 'err');
    return;
  }
  setLoginBusy(true, true);
  setLoginStatus(interactive
    ? '正在打开浏览器窗口，请在窗口里登录抖音…'
    : '正在同步登录态，请稍候…');
  pollLogin();
}

async function pollLogin(){
  if (loginTimer) return;
  const tick = async () => {
    const { data } = await api('/api/login/status');
    const st = data.status || 'idle';
    const busy = (st === 'starting' || st === 'waiting_login' || st === 'reading');
    if (data.message) lastSeen = data.message;
    setLoginStatus(data.message || '', st === 'failed' ? 'err' : '');
    setLoginBusy(busy, true);

    if (busy) return;

    clearInterval(loginTimer); loginTimer = null;

    if (st === 'done'){
      setCookieBadge(true);
      setLoginStatus('✅ ' + (data.message || '登录成功') + '　可以开始下载了', '');
      toast('登录成功', 'ok');
    } else if (st === 'failed'){
      setCookieBadge(false);
      toast(data.message || '登录未完成', 'err');
    }
  };
  loginTimer = setInterval(tick, 1200);
  tick();
}

async function forgetLogin(){
  if (!confirm('确定要退出登录吗？下次需要重新扫码登录。')) return;
  const { data } = await api('/api/login/forget', {method:'POST'});
  if (data.ok){
    toast('已退出登录', 'ok');
    setCookieBadge(false);
    lastSeen = '';
    setLoginStatus('尚未登录，请点「打开登录窗口」', '');
  } else {
    toast(data.message || '操作失败', 'err');
  }
}

/* ---------- 下载 ---------- */
function onModeChange(){
  const m = document.getElementById('mode').value;
  const show = m === 'post';
  document.getElementById('maxCountsField').style.display = show ? '' : 'none';
  document.getElementById('dateRow').style.display = show ? '' : 'none';
}

async function parseLink(){
  const url = document.getElementById('urlInput').value.trim();
  if (!url){ toast('请输入链接', 'err'); return; }
  const { data } = await api('/api/parse', {method:'POST', body: JSON.stringify({url})});
  if (data.ok){
    const i = data.info;
    // 顺便展示规范化后的地址：原链接里的 ?modal_id=xxx&type=general 等都会被抹掉
    toast(`识别为：${i.kind === 'video' ? '单个作品' : '用户主页'} · ${i.url || i.id}`);
  } else {
    toast(data.message || '解析失败', 'err');
  }
}

async function startDownload(){
  const url = document.getElementById('urlInput').value.trim();
  if (!url){ toast('请输入链接', 'err'); return; }

  const payload = {
    url,
    mode: document.getElementById('mode').value,
    max_counts: document.getElementById('maxCounts').value,
    date_start: document.getElementById('dateStart').value,
    date_end: document.getElementById('dateEnd').value,
    force: document.getElementById('forceDl').checked,
  };

  const btn = document.getElementById('dlBtn');
  btn.disabled = true;
  const { data } = await api('/api/download', {method:'POST', body: JSON.stringify(payload)});
  btn.disabled = false;

  if (data.ok){
    toast('任务已创建', 'ok');
    refreshTasks();
    startPolling();
  } else {
    toast(data.message || '创建任务失败', 'err');
    if (data.need_login){
      setLoginBusy(false, false);
      setLoginStatus(data.message, 'err');
      document.getElementById('loginBtn').scrollIntoView({behavior:'smooth', block:'center'});
    }
  }
}

async function resetHistory(){
  if (!confirm('清空下载记录后，所有作品都会重新校验一遍：\n文件还在的会秒跳过（不重新下载），被删掉的会重新下载。\n\n确定要清空吗？')) return;
  const { data } = await api('/api/reset-history', {method:'POST', body: JSON.stringify({})});
  toast(data.message || (data.ok ? '下载记录已清空' : '操作失败'), data.ok ? 'ok' : 'err');
}

/* ---------- 任务列表 ---------- */
async function refreshTasks(){
  const { data } = await api('/api/tasks');
  const box = document.getElementById('taskList');
  const tasks = (data.tasks || []);
  lastTasks = tasks;
  if (!tasks.length){ box.innerHTML = '<div class="empty">暂无任务</div>'; return; }

  box.innerHTML = tasks.map(t => {
    const label = t.kind === 'post' ? '主页批量' : '单个作品';
    const pct = t.total > 0 ? Math.min(100, Math.round(t.current / t.total * 100)) : (t.status==='done'?100:0);
    let extra = '';
    if (t.status === 'done' && t.result){
      const r = t.result;
      if (r.download_count != null){
        const resumed = r.resumed && r.resumed.length ? `，其中 ${r.resumed.length} 条是文件丢失后补下` : '';
        // 一条都没下成时，把原因说明白 —— 多半是日期区间把作品全筛掉了
        let tail = '';
        const nSkip = r.skipped ? r.skipped.length : 0;
        const nFail = r.failed ? r.failed.length : 0;
        if (r.download_count === 0 && nSkip === 0 && nFail === 0){
          if (r.date_start || r.date_end){
            const pages = r.pages_fetched ? `（已查 ${r.pages_fetched} 页）` : '';
            tail = `。没有落在 ${r.date_start || '不限'} ~ ${r.date_end || '不限'} 区间内的作品${pages}`;
          } else {
            tail = '。没有找到可下载的作品';
          }
        }
        extra = `<div class="msg">下载 ${r.download_count} 条，跳过 ${nSkip} 条` +
                (nFail ? `，失败 ${nFail} 条` : '') + resumed + tail + `</div>`;
      } else if (r.skipped){
        // 真跳过：记录在案且文件此刻确实还在
        const fname = String(r.path || '').split(/[\\/]/).pop();
        extra = `<div class="msg">本地已存在，跳过下载${fname ? '：' + escapeHtml(fname) : ''}</div>`;
      } else if (r.redownload && r.path){
        extra = `<div class="msg warn">记录显示曾下载过，但文件已丢失，已重新下载：` +
                `${escapeHtml(r.nickname||'')} ${escapeHtml((r.desc_full||r.desc||'').slice(0,36))}</div>`;
      } else if (r.path){
        extra = `<div class="msg">${escapeHtml(r.nickname||'')} ${escapeHtml((r.desc_full||r.desc||'').slice(0,40))}</div>`;
      } else if (r.skipped === false && r.path === null){
        extra = `<div class="msg warn">没有生成视频文件（可能为图文作品 / 已被屏蔽 / 私密）</div>`;
      }
    }
    const err = t.error ? `<div class="msg err">${escapeHtml(t.error)}</div>` : '';
    return `
      <div class="task">
        <div class="task-top">
          <div>
            <div class="task-name">${label} · ${escapeHtml(shortTarget(t.target))}</div>
            <div class="task-meta">${t.current}/${t.total || '?'}</div>
          </div>
          <span class="tag ${t.status}">${statusText(t.status)}</span>
        </div>
        <div class="bar ${t.status==='done'?'done':''}"><i style="width:${pct}%"></i></div>
        <div class="msg">${escapeHtml(t.message||'')}</div>
        ${extra}${err}
      </div>`;
  }).join('');
}

function statusText(s){
  return {pending:'排队中', running:'下载中', done:'已完成', failed:'失败', cancelled:'已取消'}[s] || s;
}
function escapeHtml(s){
  return String(s||'').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
// 任务标题里只显示链接的关键部分，避免 "om/jingxuan?modal_id=..." 这种被截断的谜语
function shortTarget(raw){
  let s = String(raw||'').trim();
  s = s.replace(/^https?:\/\/(www\.|m\.|v\.)?douyin\.com/i, '').replace(/^https?:\/\/(www\.)?iesdouyin\.com/i, '');
  s = s.replace(/^\/+/, '');
  return s.length > 48 ? '…' + s.slice(-48) : s;
}

function startPolling(){
  if (pollTimer) return;
  pollTimer = setInterval(refreshTasks, 1500);
}

async function openFolder(){
  const { data } = await api('/api/open-folder', {method:'POST'});
  if (!data.ok) toast(data.message || '打开失败', 'err');
}

/* ---------- 生命周期：关掉页面 = 程序退出 ----------
   程序是无窗口的 exe，用户能看见的只有这个标签页。关掉它时后端收不到
   任何信号，只能靠「心跳断掉」判断 —— 所以这里做两件事：
     1) 定期心跳，证明「还有人看着」
     2) 关闭时用 sendBeacon 主动上报，让退出更及时 */
const HEARTBEAT_MS = 3000;

function heartbeat(){
  // keepalive：让请求在页面正在卸载时也能发出去
  fetch('/api/heartbeat', {method:'POST', keepalive:true}).catch(()=>{});
}

// pagehide 在关闭 / 刷新 / 跳转时都会触发。
// 刷新也会上报，所以后端留了 4 秒宽限期 ——
// 刷新后新页面立刻发心跳，就把「待退出」取消了。
let closingSent = false;
window.addEventListener('pagehide', () => {
  if (closingSent) return;
  closingSent = true;
  try {
    navigator.sendBeacon('/api/closing', '1');
  } catch(e){
    fetch('/api/closing', {method:'POST', keepalive:true}).catch(()=>{});
  }
});

// 回到前台 / 从后退缓存恢复时立刻补一次心跳。
// 浏览器会节流甚至冻结后台标签页的定时器，醒过来必须马上报到，
// 否则后端的「心跳断了」判断会误伤正在使用的实例。
document.addEventListener('visibilitychange', () => {
  if (!document.hidden) heartbeat();
});
window.addEventListener('pageshow', heartbeat);

// 有任务在跑时拦一下，避免手滑关掉页面把下载中断掉
window.addEventListener('beforeunload', (e) => {
  const busy = lastTasks.some(t => t.status === 'running' || t.status === 'pending');
  if (!busy) return;
  e.preventDefault();
  e.returnValue = '';
  return '';
});

/* ---------- 应用窗口（无边框）集成 ----------
   同一个页面有两种宿主：系统浏览器，或应用自己的无边框窗口 ——
   由 /api/alive 的 mode 字段说明是哪一种。只有后者需要自绘窗口按钮 +
   把顶栏当拖动把手。窗口动作用 HTTP 接口而不是 pywebview 的 js_api，
   原因见 src/win_window.py 里 minimize_window 上方的注释。 */
let winChromeReady = false;
function initWindowChrome(){
  if (winChromeReady) return;
  winChromeReady = true;
  document.body.classList.add('in-app-window');
  // 顶栏是拖动把手，但里面的按钮不能被当成把手 ——
  // pywebview 从事件目标一路向上找拖动区，所以在按钮上掐断冒泡
  document.querySelectorAll('header button, header a, header input, header select')
    .forEach(el => el.addEventListener('mousedown', e => e.stopPropagation()));
  // 页面刷新后窗口可能已经是最大化态，按钮图标要跟真实状态对上
  api('/api/window/maximize').then(({data}) => {
    if (data && typeof data.maximized === 'boolean') applyMaxState(data.maximized);
  }).catch(()=>{});
  // 双击顶栏切最大化/还原 —— Windows 的老习惯，顺手补上
  const header = document.querySelector('header');
  if (header) header.addEventListener('dblclick', e => {
    if (e.target.closest('button, a, input, select')) return;
    winToggleMax();
  });
}
/* 最大化状态会同时影响三样东西：按钮图标、提示文字、顶栏还是不是拖动把手。
   最大化时把拖动区摘掉 —— 否则拖顶栏会让 pywebview 去移动一个最大化窗口，
   结果不确定。原生窗口这时应当是「还原并跟随鼠标」，那套要自己算位移，不值当。 */
function applyMaxState(maximized){
  document.body.classList.toggle('win-maximized', !!maximized);
  const header = document.querySelector('header');
  if (header) header.classList.toggle('pywebview-drag-region', !maximized);
  const btn = document.getElementById('winMax');
  if (btn) {
    btn.title = maximized ? '还原' : '最大化';
    btn.setAttribute('aria-label', btn.title);
  }
}
function winMinimize(){
  fetch('/api/window/minimize', {method:'POST'}).catch(()=>{});
}
function winToggleMax(){
  api('/api/window/maximize', {method:'POST'}).then(({data}) => {
    // 后端拿不到窗口时 maximized 为 null，那就别动图标，免得显示成反的
    if (data && typeof data.maximized === 'boolean') applyMaxState(data.maximized);
  }).catch(()=>{});
}
function winClose(){
  // 自绘的关闭按钮不会走 beforeunload，所以那道「忙时确认」得在这里补一次，
  // 否则正在下载时一点就把任务硬断了。
  const busy = lastTasks.some(t => t.status === 'running' || t.status === 'pending');
  if (busy && !confirm('还有下载任务正在进行，确定要关闭吗？')) return;
  fetch('/api/window/close', {method:'POST', keepalive:true}).catch(()=>{});
}
api('/api/alive').then(({data}) => {
  if (data && data.mode === 'window') initWindowChrome();
}).catch(()=>{});

/* ---------- 初始化 ---------- */
heartbeat();
setInterval(heartbeat, HEARTBEAT_MS);
syncThemeBtn();
loadConfig();
refreshTasks();
startPolling();
</script>
