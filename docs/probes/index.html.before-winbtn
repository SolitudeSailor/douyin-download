<!DOCTYPE html>
<html lang="zh-CN" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="light dark">
<title>抖音视频下载器</title>
<script>
/* 尽早决定主题，避免首屏闪白 */
(function(){
  try{
    var saved = localStorage.getItem('dyd-theme');
    var dark = saved ? saved === 'dark'
                     : window.matchMedia('(prefers-color-scheme: dark)').matches;
    document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
  }catch(e){}
})();
</script>
<style>
  /* ============================================================
     Claude 风格设计令牌
     ============================================================ */
  :root{
    color-scheme:light;

    /* 表面 */
    --bg:#F5F4EE;
    --surface:#FFFFFF;
    --surface-2:#FAF9F5;
    --border:#E6E4DB;
    --border-2:#D9D7CC;
    --track:#EDEBE2;

    /* 文字 */
    --text:#1C1B18;
    --text-2:#6E6C65;
    --text-3:#9C9A90;

    /* 强调 */
    --accent:#D97757;
    --accent-hover:#C05F3D;
    --accent-soft:#F7E7DF;
    --accent-ring:rgba(217,119,87,.16);
    --green:#3D7A57;
    --green-soft:#E5EFE8;
    --yellow:#956B26;
    --yellow-soft:#F7EDDA;
    --red:#B4442F;
    --red-soft:#F8E4DE;
    --blue:#5B7B96;
    --blue-soft:#E8EEF2;

    /* 形状 */
    --radius:1rem;
    --radius-sm:0.7143rem;
    --shadow:0 1px 2px rgba(30,27,20,.05), 0 2px 10px rgba(30,27,20,.035);

    /* 间距刻度 */
    --sp-1:0.2857rem;  --sp-2:0.5714rem;  --sp-3:0.8571rem;
    --sp-4:1.1429rem; --sp-5:1.5714rem; --sp-6:2.1429rem;

    /* 布局 */
    --wrap:77.1429rem;
    --aside:24.2857rem;

    /* 字体：西文/数字在前，中文在后（各自命中自己的字形） */
    --font-sans:-apple-system,BlinkMacSystemFont,"Segoe UI Variable Text","Segoe UI",
      Roboto,Inter,"Helvetica Neue","PingFang SC","HarmonyOS Sans SC","MiSans",
      "Source Han Sans SC","Noto Sans SC","Microsoft YaHei UI","Microsoft YaHei",sans-serif;
    --font-serif:"Source Han Serif SC","Noto Serif SC","Songti SC","STSong",
      SimSun,ui-serif,Georgia,"Times New Roman",serif;
    --font-mono:"JetBrains Mono","Cascadia Mono","Cascadia Code",ui-monospace,
      "SF Mono",Menlo,Consolas,"Microsoft YaHei UI","Microsoft YaHei",monospace;
  }
  html[data-theme="dark"]{
    color-scheme:dark;
    --bg:#1F1E1B;
    --surface:#262521;
    --surface-2:#2D2C27;
    --border:#3A3833;
    --border-2:#4A4842;
    --track:#35342F;
    --text:#F1EFE7;
    --text-2:#A9A79E;
    --text-3:#7C7A72;
    --accent:#D97757;
    --accent-hover:#E88A69;
    --accent-soft:rgba(217,119,87,.15);
    --accent-ring:rgba(217,119,87,.22);
    --green:#7CB392;
    --green-soft:rgba(124,179,146,.14);
    --yellow:#D6AB61;
    --yellow-soft:rgba(214,171,97,.14);
    --red:#E28A74;
    --red-soft:rgba(226,138,116,.14);
    --blue:#93B1C8;
    --blue-soft:rgba(147,177,200,.14);
    --shadow:0 1px 2px rgba(0,0,0,.3), 0 2px 12px rgba(0,0,0,.18);
  }

  /* ============================================================
     基础
     ============================================================ */
  *{margin:0;padding:0;box-sizing:border-box;}
  /* 基准字号随窗口宽度流式放大：1164px 时正好 14px（=1.0 倍），
     到约 1455px 封顶 17.5px（=1.25 倍）。页面上所有尺寸都用 rem，
     于是窗口变大时界面整体等比放大，而不是只有空白变多。
     用 rem 而不是 zoom：整数/非整数倍都不会让文字发糊。 */
  html{font-size:clamp(14px,1.2028vw,17.5px);scroll-behavior:smooth;}
  body{
    background:var(--bg);color:var(--text);
    font-family:var(--font-sans);
    font-size:1rem;line-height:1.65;
    -webkit-font-smoothing:antialiased;
    text-rendering:optimizeLegibility;
    padding:0 0 2.8571rem;
  }
  /* 换主题那一帧由 JS 挂上这个类，把所有过渡关掉：
     否则大面积背景在 0.2s 里慢慢化过去、小块元素却已经跳完了，
     看起来就像「慢半拍 / 有延迟」。平时不挂，hover/focus 过渡照旧。 */
  html.no-anim *,html.no-anim *::before,html.no-anim *::after{
    transition:none !important;}
  .wrap{max-width:var(--wrap);margin:0 auto;padding:0 1.7143rem;}

  ::selection{background:var(--accent-soft);color:var(--text);}
  ::-webkit-scrollbar{width:11px;height:11px;}
  ::-webkit-scrollbar-track{background:transparent;}
  /* 滚动条属于系统外壳，尺寸不参与等比缩放 */
  ::-webkit-scrollbar-thumb{background:var(--border-2);border-radius:8px;
    border:3px solid var(--bg);}
  ::-webkit-scrollbar-thumb:hover{background:var(--text-3);}

  :focus-visible{outline:2px solid var(--accent);outline-offset:2px;}

  /* ============================================================
     顶栏
     ============================================================ */
  header{
    background:color-mix(in srgb,var(--bg) 88%,transparent);
    backdrop-filter:saturate(160%) blur(12px);
    -webkit-backdrop-filter:saturate(160%) blur(12px);
    border-bottom:1px solid var(--border);
    padding:1.4286rem 0 1.1429rem;margin-bottom:var(--sp-6);
    position:sticky;top:0;z-index:20;
  }
  header .wrap{display:flex;align-items:center;justify-content:space-between;
    gap:var(--sp-4);flex-wrap:wrap;}
  .brand{display:flex;align-items:center;gap:0.7857rem;}
  .mark{display:inline-flex;color:var(--accent);}
  .mark svg{width:1.5714rem;height:1.5714rem;fill:currentColor;display:block;}
  /* 内容区图标跟着字号放大。右上角那排窗口按钮（.win-controls）不在此列：
     它们属于窗口外壳，尺寸固定 30px。 */
  #themeBtn svg{width:1.0714rem;height:1.0714rem;}
  h1{font-family:var(--font-serif);font-size:1.5714rem;font-weight:600;
    letter-spacing:-.015em;line-height:1.2;}
  .sub{font-size:0.75rem;color:var(--text-3);letter-spacing:.09em;
    text-transform:uppercase;margin-top:0.1429rem;font-weight:500;}
  .status{display:flex;gap:0.7143rem;align-items:center;flex-wrap:wrap;}
  .status-actions{display:flex;gap:0.5714rem;align-items:center;}

  /* ---------- 应用窗口（无边框）----------
     页面既可能开在系统浏览器里，也可能装进应用自己的无边框窗口。
     只有后者才需要：顶栏当拖动把手 + 自绘的最小化/关闭按钮。 */
  header.pywebview-drag-region{cursor:default;user-select:none;
    -webkit-user-select:none;}
  header.pywebview-drag-region .status-actions button{cursor:pointer;}
  .win-controls{display:none;gap:2px;align-items:center;margin-left:2px;
    padding-left:9px;border-left:1px solid var(--border);}
  body.in-app-window .win-controls{display:flex;}
  .win-controls button{width:30px;height:30px;padding:0;
    display:inline-flex;align-items:center;justify-content:center;}
  .win-controls button svg{display:block;}
  /* 最大化/还原两套图标，靠 body 上的状态类切换 */
  .win-controls #winMax .ico-restore{display:none;}
  body.win-maximized .win-controls #winMax .ico-max{display:none;}
  body.win-maximized .win-controls #winMax .ico-restore{display:block;}
  .win-controls #winClose:hover{background:#E5484D;border-color:#E5484D;
    color:#fff;}

  .badge{padding:0.2857rem 0.7857rem;border-radius:71.3571rem;font-size:0.8214rem;font-weight:600;
    display:inline-flex;align-items:center;gap:0.4286rem;white-space:nowrap;
    letter-spacing:.01em;}
  .badge::before{content:"";width:0.4286rem;height:0.4286rem;border-radius:50%;
    background:currentColor;opacity:.85;flex:none;}
  .badge.ok{background:var(--green-soft);color:var(--green);}
  .badge.bad{background:var(--yellow-soft);color:var(--yellow);}

  /* ============================================================
     布局：窄屏单列（登录→下载→任务），宽屏两栏
     ============================================================ */
  .layout{display:grid;gap:1.4286rem;align-items:start;}

  @media (min-width:1000px){
    .layout{
      grid-template-columns:var(--aside) minmax(0,1fr);
      grid-template-areas:
        "login dl"
        "tasks tasks";
      align-items:stretch;
    }
    .card--dl   {grid-area:dl;}
    .card--login{grid-area:login;
      display:flex;flex-direction:column;}
    .card--tasks{grid-area:tasks;}
    /* 登录卡被拉高后，把富余空白吃到 details 之上，让它底边与右侧
       下载卡的收尾元素同线。必须 scoped 在 media 内：全局化会在窄屏
       把 details 的 margin-top:var(--sp-4) 压成 0，破坏窄屏间距。 */
    .card--login details{margin-top:auto;}
  }

  /* ============================================================
     卡片
     ============================================================ */
  .card{
    background:var(--surface);border:1px solid var(--border);
    border-radius:var(--radius);padding:1.7143rem;
    box-shadow:var(--shadow);
  }

  .card-head{display:flex;align-items:center;justify-content:space-between;
    gap:var(--sp-3);margin-bottom:var(--sp-5);}
  .card-head h2{font-size:1.0714rem;font-weight:650;letter-spacing:-.005em;
    display:flex;align-items:center;gap:0.7143rem;line-height:1.3;}
  .ico{width:1.8571rem;height:1.8571rem;border-radius:0.5714rem;flex:none;
    background:var(--accent-soft);color:var(--accent);
    display:inline-flex;align-items:center;justify-content:center;}
  .ico svg{width:1.0714rem;height:1.0714rem;display:block;fill:none;
    stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;}

  /* ============================================================
     表单
     ============================================================ */
  .field{margin-bottom:var(--sp-4);}
  label{display:block;font-size:0.8929rem;color:var(--text-2);
    margin-bottom:0.5rem;font-weight:550;letter-spacing:.01em;}
  input,textarea,select{
    width:100%;background:var(--surface-2);border:1px solid var(--border-2);
    border-radius:var(--radius-sm);padding:0.7857rem 0.9286rem;color:var(--text);
    font-size:0.9643rem;font-family:var(--font-sans);line-height:1.55;
    outline:none;
    transition:border-color .15s,box-shadow .15s,background .15s;
  }
  input:hover,textarea:hover,select:hover{border-color:var(--text-3);}
  input:focus,textarea:focus,select:focus{
    border-color:var(--accent);background:var(--surface);
    box-shadow:0 0 0 3.5px var(--accent-ring);
  }
  input::placeholder,textarea::placeholder{color:var(--text-3);}
  textarea{resize:vertical;min-height:6.8571rem;}
  select{cursor:pointer;appearance:none;
    background-image:linear-gradient(45deg,transparent 50%,var(--text-2) 50%),
                     linear-gradient(135deg,var(--text-2) 50%,transparent 50%);
    background-position:calc(100% - 18px) 50%,calc(100% - 13px) 50%;
    background-size:5px 5px,5px 5px;background-repeat:no-repeat;
    padding-right:2.4286rem;}

  .label-row{display:flex;align-items:center;justify-content:space-between;
    gap:var(--sp-3);margin-bottom:0.5rem;}
  .label-row label{margin-bottom:0;}

  .row{display:grid;grid-template-columns:repeat(auto-fit,minmax(10.7143rem,1fr));
    gap:var(--sp-4);}
  .hint{font-size:0.8571rem;color:var(--text-3);margin-top:0.4286rem;line-height:1.7;}
  .hint strong{color:var(--text-2);font-weight:600;}
  .hint:last-child{margin-bottom:0;}

  /* 选项区：把「模式 / 条数 / 日期」收进一块次级面板 */
  .options{
    background:var(--surface-2);border:1px solid var(--border);
    border-radius:var(--radius-sm);padding:1.1429rem 1.1429rem 0.1429rem;
    margin-bottom:var(--sp-4);
  }
  .options input,.options select{background:var(--surface);}
  .options .field{margin-bottom:1rem;}

  /* ============================================================
     按钮
     ============================================================ */
  button{
    background:var(--accent);color:#fff;border:1px solid transparent;
    border-radius:var(--radius-sm);padding:0.7143rem 1.2857rem;font-size:0.9643rem;
    font-weight:600;cursor:pointer;font-family:inherit;line-height:1.45;
    white-space:nowrap;
    transition:background .15s,border-color .15s,color .15s,transform .08s;
  }
  button:hover{background:var(--accent-hover);}
  button:active{transform:scale(.985);}
  button:disabled{opacity:.45;cursor:not-allowed;transform:none;}
  button.ghost{background:var(--surface);border-color:var(--border-2);
    color:var(--text-2);}
  button.ghost:hover{background:var(--surface);border-color:var(--text-3);
    color:var(--text);}
  button.sm{padding:0.5rem 0.9286rem;font-size:0.8929rem;}
  button.icon{padding:0.5rem 0.7143rem;font-size:0.9286rem;line-height:1;
    display:inline-flex;align-items:center;justify-content:center;}
  button.icon svg{display:block;}
  .btn-row{display:flex;gap:0.7143rem;flex-wrap:wrap;align-items:center;}
  /* 登录卡片：主操作独占一行，两个次要操作平分一行 */
  .card--login .btn-row{display:grid;grid-template-columns:1fr 1fr;gap:0.5714rem;}
  .card--login .btn-row #loginBtn{grid-column:1 / -1;}
  .actions{display:flex;gap:var(--sp-4);flex-wrap:wrap;align-items:center;
    margin-top:var(--sp-2);}

  .chk{display:inline-flex;align-items:center;gap:0.5rem;font-size:0.8929rem;
    color:var(--text-2);cursor:pointer;user-select:none;white-space:nowrap;}
  .chk input{width:auto;accent-color:var(--accent);cursor:pointer;
    background:none;border:none;padding:0;}

  /* ============================================================
     登录状态行
     ============================================================ */
  .status-line{
    background:var(--surface-2);border:1px solid var(--border);
    border-radius:0.6429rem;padding:0.7143rem 0.8571rem;margin-bottom:var(--sp-4);
  }
  .status-line .msg{margin-top:0;}

  /* ============================================================
     折叠说明
     ============================================================ */
  details{border:1px solid var(--border);border-radius:var(--radius-sm);
    padding:0.8571rem 1rem;background:var(--surface-2);margin-top:var(--sp-4);}
  summary{cursor:pointer;font-size:0.8929rem;font-weight:600;color:var(--text-2);
    list-style:none;}
  summary::-webkit-details-marker{display:none;}
  summary::before{content:"›";display:inline-block;margin-right:0.5714rem;
    color:var(--text-3);transition:transform .18s;font-weight:700;}
  details[open] summary::before{transform:rotate(90deg);}
  summary:hover{color:var(--text);}
  details[open] summary{margin-bottom:0.7143rem;}
  details ol{margin-left:1.4286rem;font-size:0.8929rem;color:var(--text-2);}
  details ol li{margin-bottom:0.4286rem;}
  details ol li:last-child{margin-bottom:0;}
  details code{background:var(--accent-soft);padding:0.1429rem 0.4286rem;border-radius:0.3571rem;
    font-size:0.8214rem;color:var(--accent);font-family:var(--font-mono);}

  /* ============================================================
     任务列表
     ============================================================ */
  .task{border:1px solid var(--border);border-radius:var(--radius-sm);
    padding:1rem 1.1429rem;margin-bottom:0.7143rem;background:var(--surface-2);}
  .task:last-child{margin-bottom:0;}
  .task-top{display:flex;justify-content:space-between;gap:var(--sp-3);
    align-items:flex-start;margin-bottom:0.6429rem;}
  .task-name{font-size:0.9286rem;font-weight:600;word-break:break-all;
    line-height:1.5;}
  .task-meta{font-size:0.8214rem;color:var(--text-3);margin-top:0.2143rem;
    font-variant-numeric:tabular-nums;letter-spacing:.01em;}
  .tag{padding:0.2143rem 0.7143rem;border-radius:71.3571rem;font-size:0.7857rem;font-weight:650;
    white-space:nowrap;flex:none;}
  .tag.running{background:var(--blue-soft);color:var(--blue);}
  .tag.done{background:var(--green-soft);color:var(--green);}
  .tag.failed{background:var(--red-soft);color:var(--red);}
  .tag.pending{background:var(--track);color:var(--text-3);}
  .tag.cancelled{background:var(--yellow-soft);color:var(--yellow);}

  .bar{height:0.3571rem;background:var(--track);border-radius:0.2143rem;overflow:hidden;
    margin-top:0.7143rem;}
  .bar > i{display:block;height:100%;background:var(--accent);
    border-radius:0.2143rem;transition:width .35s ease;width:0;}
  .bar.done > i{background:var(--green);}
  .msg{font-size:0.8571rem;color:var(--text-2);margin-top:0.5714rem;line-height:1.6;}
  .msg.err{color:var(--red);word-break:break-all;}
  .msg.warn{color:var(--yellow);}
  .empty{text-align:center;color:var(--text-3);font-size:0.8929rem;
    padding:1.8571rem 0;}

  /* ============================================================
     页脚 / Toast
     ============================================================ */
  .foot{max-width:var(--wrap);margin:var(--sp-5) auto 0;padding:0 1.7143rem;
    font-size:0.8214rem;color:var(--text-3);text-align:center;
    letter-spacing:.01em;}

  #toast{
    position:fixed;bottom:28px;left:50%;
    transform:translateX(-50%) translateY(90px);
    background:var(--surface);border:1px solid var(--border);
    border-radius:0.8571rem;padding:0.8571rem 1.4286rem;font-size:0.9286rem;
    opacity:0;transition:all .3s cubic-bezier(.22,.61,.36,1);
    pointer-events:none;z-index:99;max-width:80vw;
    box-shadow:0 8px 28px rgba(30,27,20,.14),0 2px 6px rgba(30,27,20,.06);
  }
  html[data-theme="dark"] #toast{
    box-shadow:0 8px 28px rgba(0,0,0,.45),0 2px 6px rgba(0,0,0,.3);}
  #toast.show{opacity:1;transform:translateX(-50%) translateY(0);}
  #toast.err{border-color:var(--red);color:var(--red);}
  #toast.ok{border-color:var(--green);color:var(--green);}

  /* ============================================================
     窄屏微调
     ============================================================ */
  @media (max-width:640px){
    .wrap{padding:0 1.1429rem;}
    header{padding:1.0714rem 0 0.9286rem;margin-bottom:var(--sp-5);}
    h1{font-size:1.3571rem;}
    .sub{display:none;}
    .card{padding:1.2857rem;}
    .foot{padding:0 1.1429rem;}
  }
</style>
</head>
<body>

<header class="pywebview-drag-region">
  <div class="wrap">
    <div class="brand">
      <span class="mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22">
          <path d="M12 2C12.8 7.2 16.8 11.2 22 12C16.8 12.8 12.8 16.8 12 22C11.2 16.8 7.2 12.8 2 12C7.2 11.2 11.2 7.2 12 2Z"/>
        </svg>
      </span>
      <div>
        <h1>抖音视频下载器</h1>
        <p class="sub">Douyin Video Downloader</p>
      </div>
    </div>
    <div class="status">
      <span class="badge" id="cookieBadge">检查中...</span>
      <div class="status-actions">
        <button class="ghost sm" onclick="openFolder()">打开下载目录</button>
        <button class="ghost sm" onclick="resetHistory()" title="清空后，已下载的作品会重新校验一遍">清空下载记录</button>
        <button class="ghost sm icon" id="themeBtn" onclick="toggleTheme()" title="切换主题">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.6A8.6 8.6 0 1 1 9.4 4a6.9 6.9 0 0 0 10.6 10.6z"/></svg>
        </button>
        <!-- 仅在应用窗口里显示：浏览器标签页有自己的最小化/关闭 -->
        <div class="win-controls" id="winControls">
          <button class="ghost sm icon" onclick="winMinimize()" title="最小化" aria-label="最小化">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M5.5 12h13"/></svg>
          </button>
          <button class="ghost sm icon" id="winMax" onclick="winToggleMax()" title="最大化" aria-label="最大化">
            <svg class="ico-max" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><rect x="6.5" y="6.5" width="11" height="11" rx="1.6"/></svg>
            <svg class="ico-restore" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="8.5" y="8.5" width="9.5" height="9.5" rx="1.6"/><path d="M6 15.5V7.6A1.6 1.6 0 0 1 7.6 6h7.9"/></svg>
          </button>
          <button class="ghost sm icon" id="winClose" onclick="winClose()" title="关闭" aria-label="关闭">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M6.5 6.5l11 11M17.5 6.5l-11 11"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</header>

<main class="wrap">
